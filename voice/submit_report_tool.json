{
  "type": "function",
  "function": {
    "name": "submit_report",
    "description": "Submit an incoming ambulance report to the ER board. Call once you have unit, age, complaint, acuity, ETA, and (for stable patients) the three lobby-screen answers.",
    "parameters": {
      "type": "object",
      "properties": {
        "unit": {
          "type": "string",
          "description": "Ambulance unit name, e.g. 'Medic 12'"
        },
        "age": {
          "type": "integer",
          "description": "Patient age in years"
        },
        "complaint": {
          "type": "string",
          "description": "Chief complaint, a few words, e.g. 'chest pain'"
        },
        "acuity": {
          "type": "string",
          "enum": [
            "stable",
            "critical"
          ],
          "description": "Patient stability"
        },
        "eta_min": {
          "type": "integer",
          "description": "Minutes until arrival at the ER"
        },
        "ambulatory": {
          "type": "boolean",
          "description": "Patient can walk. Always false for critical patients."
        },
        "alert_oriented": {
          "type": "boolean",
          "description": "Patient is alert and oriented. Always false for critical patients."
        },
        "vitals_stable": {
          "type": "boolean",
          "description": "Vitals are stable. Always false for critical patients."
        },
        "high_risk_complaint": {
          "type": "boolean",
          "description": "True if the complaint involves chest pain, stroke, breathing trouble, seizure, bleeding, head injury, trauma, unconsciousness, overdose, or pregnancy. Otherwise false."
        }
      },
      "required": [
        "unit",
        "age",
        "complaint",
        "acuity",
        "eta_min",
        "ambulatory",
        "alert_oriented",
        "vitals_stable",
        "high_risk_complaint"
      ]
    }
  },
  "server": {
    "url": "{PUBLIC_URL}/report",
    "headers": {
      "ngrok-skip-browser-warning": "1"
    }
  },
  "messages": [
    {
      "type": "request-start",
      "content": "Logging that with the ER now."
    },
    {
      "type": "request-complete",
      "content": "Logged with the ER. Lobby-eligible, pending nurse approval. Copy, see you soon.",
      "endCallAfterSpokenEnabled": true,
      "conditions": [
        {
          "param": "acuity",
          "operator": "eq",
          "value": "stable"
        },
        {
          "param": "age",
          "operator": "gte",
          "value": "18"
        },
        {
          "param": "ambulatory",
          "operator": "eq",
          "value": "true"
        },
        {
          "param": "alert_oriented",
          "operator": "eq",
          "value": "true"
        },
        {
          "param": "vitals_stable",
          "operator": "eq",
          "value": "true"
        },
        {
          "param": "high_risk_complaint",
          "operator": "eq",
          "value": "false"
        }
      ]
    },
    {
      "type": "request-complete",
      "content": "Logged with the ER. Copy, see you soon.",
      "endCallAfterSpokenEnabled": true,
      "conditions": [
        {
          "param": "acuity",
          "operator": "eq",
          "value": "critical"
        }
      ]
    },
    {
      "type": "request-complete",
      "content": "Logged with the ER. Copy, see you soon.",
      "endCallAfterSpokenEnabled": true,
      "conditions": [
        {
          "param": "acuity",
          "operator": "eq",
          "value": "stable"
        },
        {
          "param": "age",
          "operator": "lt",
          "value": "18"
        }
      ]
    },
    {
      "type": "request-complete",
      "content": "Logged with the ER. Copy, see you soon.",
      "endCallAfterSpokenEnabled": true,
      "conditions": [
        {
          "param": "acuity",
          "operator": "eq",
          "value": "stable"
        },
        {
          "param": "age",
          "operator": "gte",
          "value": "18"
        },
        {
          "param": "ambulatory",
          "operator": "eq",
          "value": "false"
        }
      ]
    },
    {
      "type": "request-complete",
      "content": "Logged with the ER. Copy, see you soon.",
      "endCallAfterSpokenEnabled": true,
      "conditions": [
        {
          "param": "acuity",
          "operator": "eq",
          "value": "stable"
        },
        {
          "param": "age",
          "operator": "gte",
          "value": "18"
        },
        {
          "param": "ambulatory",
          "operator": "eq",
          "value": "true"
        },
        {
          "param": "alert_oriented",
          "operator": "eq",
          "value": "false"
        }
      ]
    },
    {
      "type": "request-complete",
      "content": "Logged with the ER. Copy, see you soon.",
      "endCallAfterSpokenEnabled": true,
      "conditions": [
        {
          "param": "acuity",
          "operator": "eq",
          "value": "stable"
        },
        {
          "param": "age",
          "operator": "gte",
          "value": "18"
        },
        {
          "param": "ambulatory",
          "operator": "eq",
          "value": "true"
        },
        {
          "param": "alert_oriented",
          "operator": "eq",
          "value": "true"
        },
        {
          "param": "vitals_stable",
          "operator": "eq",
          "value": "false"
        }
      ]
    },
    {
      "type": "request-complete",
      "content": "Logged with the ER. Copy, see you soon.",
      "endCallAfterSpokenEnabled": true,
      "conditions": [
        {
          "param": "acuity",
          "operator": "eq",
          "value": "stable"
        },
        {
          "param": "age",
          "operator": "gte",
          "value": "18"
        },
        {
          "param": "ambulatory",
          "operator": "eq",
          "value": "true"
        },
        {
          "param": "alert_oriented",
          "operator": "eq",
          "value": "true"
        },
        {
          "param": "vitals_stable",
          "operator": "eq",
          "value": "true"
        },
        {
          "param": "high_risk_complaint",
          "operator": "eq",
          "value": "true"
        }
      ]
    },
    {
      "type": "request-failed",
      "content": "I couldn't reach the ER board. Please radio the report in directly."
    }
  ]
}
