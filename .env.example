# Vapi dashboard -> API Keys (private key)
VAPI_API_KEY=
# Vapi dashboard -> Phone Numbers -> your free number's ID
VAPI_PHONE_NUMBER_ID=
# Vapi dashboard -> Assistants -> "Handoff Charge Nurse" ID (only for the Vapi fallback nurse call)
VAPI_NURSE_ASSISTANT_ID=
# Phone that plays the charge nurse, E.164 format, e.g. +15551234567
NURSE_PHONE=
# ngrok https URL, no trailing slash, e.g. https://abcd-1-2-3-4.ngrok-free.app
# (also required for the Twilio nurse call: Twilio fetches {PUBLIC_URL}/twiml/surge)
PUBLIC_URL=

# --- Twilio: outbound nurse call (primary; used instead of Vapi when all are set) ---
# Twilio console -> Account Info
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Your Twilio phone number, E.164 format, e.g. +15551234567
TWILIO_PHONE_NUMBER=
# Trial accounts can only call verified numbers: NURSE_PHONE must be verified in the Twilio console.
